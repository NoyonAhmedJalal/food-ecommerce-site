# Copy this file to .env and adjust the values.

# Port the Express server listens on
PORT=3000

# MongoDB connection string.
# Local install:  mongodb://127.0.0.1:27017/foodies
# MongoDB Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/foodies
MONGODB_URI=mongodb://127.0.0.1:27017/foodies

# Fallback DNS servers used only when the system DNS cannot resolve an Atlas
# mongodb+srv:// host. Leave unset to use 8.8.8.8,1.1.1.1 automatically.
# DNS_SERVERS=8.8.8.8,1.1.1.1

# Secret used to sign the admin session cookie (use a long random string)
SESSION_SECRET=change-this-to-a-long-random-secret

# Credentials created for the admin panel on first run
ADMIN_EMAIL=admin@foodies.com
ADMIN_PASSWORD=Admin@123

# Set to "true" when running behind a proxy on HTTPS
TRUST_PROXY=false
